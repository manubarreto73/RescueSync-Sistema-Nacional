# ---------- App ----------
NODE_ENV=development
# En Railway no se define: la plataforma inyecta PORT.
PORT=3001
API_PREFIX=api
SWAGGER_ENABLED=true

# ---------- PostgreSQL (docker-compose local) ----------
POSTGRES_USER=nacional
POSTGRES_PASSWORD=nacional
POSTGRES_DB=sistema_nacional
# 5435 para no chocar con otros PostgreSQL de la maquina (5432-5434).
POSTGRES_PORT=5435

# Corriendo la app fuera de Docker -> host "localhost".
# Dentro de Docker, docker-compose pisa esta variable con el host "postgres".
# En Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://nacional:nacional@localhost:5435/sistema_nacional?schema=public
DB_LOGGING=false

# ---------- Seguridad / JWT ----------
# Obligatorio, minimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CAMBIAR_ESTE_VALOR_POR_UNO_GENERADO_DE_48_BYTES_EN_BASE64
JWT_EXPIRATION=1h
BCRYPT_SALT_ROUNDS=10

# ---------- CORS ----------
# Los consumidores son sistemas (servidor a servidor); Swagger es del mismo origen.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Seed ----------
# Contrasenas de las cuentas que crea el seed. En la nube, definirlas como
# variables del servicio: el seed corre en cada arranque y las actualiza.
SEED_ADMIN_PASSWORD=Nacional2026!
SEED_BONITA_PASSWORD=Bonita2026!
SEED_APP_WEB_PASSWORD=AppWeb2026!
# Contrasena de las cuentas de las ONGs de demostracion.
SEED_DEMO_PASSWORD=Rescue2026!
