# Entorno de los tests e2e: otra base de PostgreSQL (sistema_nacional_test),
# que la suite trunca a gusto sin tocar la de desarrollo.

NODE_ENV=test
PORT=3001
API_PREFIX=api
SWAGGER_ENABLED=false

DATABASE_URL=postgresql://nacional:nacional@localhost:5435/sistema_nacional_test?schema=public
DB_LOGGING=false

JWT_SECRET=secreto-solo-para-tests-no-usar-en-ningun-otro-lado-1234567890
JWT_EXPIRATION=1h
# Cost bajo a proposito: la suite hace decenas de logins.
BCRYPT_SALT_ROUNDS=4

CORS_ALLOWED_ORIGINS=http://localhost:5173

THROTTLE_ENABLED=false
