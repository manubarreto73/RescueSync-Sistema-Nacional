    {
      "name": "Onboarding",
      "description": "Registro de ONGs. Publico: crea la organizacion y su cuenta de acceso.",
      "item": [
        {
          "name": "Registrar ONG",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/onboarding/ong",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "onboarding",
                "ong"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{nombreOnboarding}}\",\n  \"tipo\": \"ONG\",\n  \"cuit\": \"{{cuitOnboarding}}\",\n  \"email\": \"{{emailOnboarding}}\",\n  \"password\": \"Postman2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Datos unicos por corrida, para poder ejecutar la coleccion varias veces.",
                  "const sufijo = Date.now().toString().slice(-8);",
                  "pm.collectionVariables.set('nombreOnboarding', 'ONG Postman ' + sufijo);",
                  "pm.collectionVariables.set('cuitOnboarding', '30' + sufijo + '9');",
                  "pm.collectionVariables.set('emailOnboarding', 'postman' + sufijo + '@demo.ar');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Queda habilitada con codigo nacional', () => {",
                  "  pm.expect(body.estado).to.eql('HABILITADA');",
                  "  pm.expect(body.codigoNacional).to.match(/^ONG-\\d{4,}$/);",
                  "});",
                  "pm.collectionVariables.set('codigoOnboarding', body.codigoNacional);"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar ONG con email repetido (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
