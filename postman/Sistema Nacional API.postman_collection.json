    {
      "name": "Validaciones",
      "description": "Validacion por niveles de competencia. La invoca Bonita al vencer la convocatoria. Nunca rechaza: cada linea vuelve PRINCIPAL o APOYO_SECUNDARIO.",
      "item": [
        {
          "name": "Validar ofertas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/validaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "validaciones"
              ]
            },
            "description": "Linea 1: certificacion suficiente (PRINCIPAL). Linea 2: nivel bajo. Linea 3: certificacion vencida. Linea 4: ONG suspendida. Las tres ultimas salen APOYO_SECUNDARIO.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gravedad\": \"ALTA\",\n  \"lineas\": [\n    {\n      \"lineaId\": 1,\n      \"codigoNacional\": \"ONG-0001\",\n      \"categoria\": \"PERSONAL\",\n      \"cantidad\": 5\n    },\n    {\n      \"lineaId\": 2,\n      \"codigoNacional\": \"ONG-0003\",\n      \"categoria\": \"PERSONAL\",\n      \"cantidad\": 3\n    },\n    {\n      \"lineaId\": 3,\n      \"codigoNacional\": \"ONG-0003\",\n      \"categoria\": \"MEDICAMENTOS\",\n      \"cantidad\": 50\n    },\n    {\n      \"lineaId\": 4,\n      \"codigoNacional\": \"ONG-0004\",\n      \"categoria\": \"ALIMENTOS\",\n      \"cantidad\": 200\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const [principal, nivelBajo, vencida, suspendida] = pm.response.json().resultados;",
                  "pm.test('Linea 1 es PRINCIPAL', () => pm.expect(principal.caracter).to.eql('PRINCIPAL'));",
                  "pm.test('Las demas son APOYO_SECUNDARIO, sin rechazo', () => {",
                  "  [nivelBajo, vencida, suspendida].forEach((r) => pm.expect(r.caracter).to.eql('APOYO_SECUNDARIO'));",
                  "});"
                ]
              }
            }
          ]
        },
