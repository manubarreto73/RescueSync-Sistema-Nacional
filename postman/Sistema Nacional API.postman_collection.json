    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Estado de la API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('PostgreSQL arriba', () => pm.expect(pm.response.json().info.postgres.status).to.eql('up'));"
                ]
              }
            }
          ]
        }
      ]
