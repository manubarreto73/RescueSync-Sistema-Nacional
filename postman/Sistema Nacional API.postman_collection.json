    {
      "name": "Flujo del proyecto (Bonita)",
      "description": "Compromiso con bloqueo transaccional (eslabon 6) y cierre con liberacion de recursos (eslabon 7). Ejecutar en orden.",
      "item": [
        {
          "name": "1. Comprometer recursos de las ONGs adjudicadas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/proyectos/{{proyectoRef}}/compromisos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "proyectos",
                "{{proyectoRef}}",
                "compromisos"
              ]
            },
            "body": {
              "mode": "raw",
